{
  "name": "marina-pos",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @marina/shared build && pnpm -r --parallel --filter @marina/shared --filter @marina/api --filter @marina/web dev",
    "build": "pnpm --filter @marina/shared build && pnpm --filter @marina/web build && pnpm --filter @marina/api build",
    "start": "pnpm --filter @marina/api start",
    "test": "pnpm --filter @marina/shared build && pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @marina/api db:migrate",
    "db:seed": "pnpm --filter @marina/api db:seed",
    "db:reset": "pnpm --filter @marina/api db:reset",
    "release:win": "node scripts/build-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "0.27.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "type": "module"
}
