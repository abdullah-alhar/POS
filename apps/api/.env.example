# Copy to .env for development.
DATABASE_URL="postgresql://pos:pos@localhost:5432/marina_pos"
# Any long random string. The Windows installer generates one automatically.
JWT_SECRET="dev-only-change-me-dev-only-change-me"
PORT=3000
HOST=127.0.0.1
# Where backups, logs and other files are kept.
STORAGE_DIR=./storage

# Development only: run pg_dump / pg_restore inside the Docker database container.
# PG_DOCKER_CONTAINER=marina-pos-db
# Windows: folder with pg_dump.exe (the installer sets this).
# PG_BIN_DIR=C:\\MarinaPOS\\pgsql\\bin
